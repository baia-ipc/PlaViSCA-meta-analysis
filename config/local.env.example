# Copy to config/local.env (not tracked by git) and adapt.

# Workspace: inputs/ (downloaded and author data) and runs/<run>/ (outputs).
# Kept outside this code directory.
PLAVISCA_WORKSPACE=/path/to/workspace

# Name of the run directory under runs/.
PLAVISCA_RUN=main

# Cores used where the pipeline works in parallel (stage 10 reads the runs
# of a study in parallel). Does not change the results.
PLAVISCA_THREADS=8
